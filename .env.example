# The name clients will use to reach this hub: its hostname, without scheme or port.
# Tailscale: <machine>.<tailnet>.ts.net   Caddy: the domain in your DNS record.
WMLHUB_HUB_NAME=hub.example.com

# invite (default): new accounts need `docker compose exec hub wmlhub invite create`
# open: anyone who can reach the hub may register, rate limited
WMLHUB_REGISTRATION=invite
